meta {
  name: 03 - Cadastrar
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/relogios
  body: json
  auth: none
}

body:json {
  {
    "marca": "Orient",
    "modelo": "Bambino",
    "tipo": "Automático",
    "preco": 1290.00
  }
}

script:post-response {
  bru.setVar("relogioId", res.body.id);
}

tests {
  test("retorna 201 Created", function() {
    expect(res.status).to.equal(201);
  });
}
